

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum MerchantStatus {
  ACTIVE
  SUSPENDED
  ONBOARDING
}

enum IntegrationMode {
  MODE_A 
  MODE_B 
}

enum SyncStatus {
  PENDING
  RUNNING
  SUCCESS
  FAILED
  PARTIAL
}

enum ProductStatus {
  ACTIVE
  DRAFT
  ARCHIVED
}

enum AvailabilityStatus {
  IN_STOCK
  OUT_OF_STOCK
  PREORDER
  DISCONTINUED
}

enum CartStatus {
  ACTIVE
  CHECKED_OUT
  ABANDONED
  EXPIRED
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
  REFUNDED
  FAILED
}

enum FulfillmentStatus {
  UNFULFILLED
  PARTIALLY_FULFILLED
  FULFILLED
  RETURNED
}

enum TransactionStatus {
  INTENT_CREATED
  BOUNDS_CHECKED
  GATE_APPROVED
  GATE_REJECTED
  OUTBOX_WRITTEN
  PSP_INITIATED
  PSP_AUTHORIZED
  PSP_PENDING
  PSP_SUCCEEDED
  PSP_FAILED
  CAPTURE_SKIPPED
  UNCERTAIN
  FULFILLMENT_TRIGGERED
  SETTLED
  REFUNDED
  FAILED
}

enum EventType {
  INTENT_CREATED
  BOUNDS_CHECKED
  GATE_DECISION
  GATE_DECISION_PRE_CAPTURE
  OUTBOX_WRITTEN
  PSP_INITIATED
  PSP_AUTHORIZED
  PSP_CAPTURED
  PSP_WEBHOOK_RECEIVED
  CAPTURE_SKIPPED
  RECONCILED
  FULFILLMENT_TRIGGERED
  FULFILLED
  SETTLED
  FAILED
  REFUNDED
  CANCELLED
  ORDER_UPDATE_RECEIVED
  STATUS_PROPAGATED
}

enum GateDecision {
  APPROVED
  REJECTED
  REQUIRES_STEP_UP
}

enum OutboxStatus {
  PENDING
  PROCESSING
  DONE
  FAILED
}

model Merchant {
  id              String          @id @default(uuid())
  name            String
  slug            String          @unique 
  status          MerchantStatus  @default(ONBOARDING)
  integrationMode IntegrationMode @default(MODE_A)

  email           String
  websiteUrl      String?

  currency        String          @default("INR") 
  taxMode         String          @default("inclusive") 
  fulfillmentRegions String[]     @default([])

  apiKeyHash      String          @unique 
  apiKeyPrefix    String          

  razorpayKeyId   String?
  razorpayKeySecretEncrypted String? 

  agentPolicy     Json?

  fulfillmentWebhookUrl  String?
  cancellationWebhookUrl String?
  webhookSigningSecret   String?  

  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  syncConfig      MerchantSyncConfig?
  syncLogs        SyncLog[]
  products        Product[]
  carts           Cart[]
  orders          Order[]
  paymentIntents  PaymentIntent[]
  users           User[]

  @@index([slug])
  @@index([apiKeyPrefix])
  @@map("merchants")
}

model User {
  id           String    @id @default(uuid())
  email        String    @unique
  passwordHash String
  role         String    @default("merchant") 
  merchantId   String?
  merchant     Merchant? @relation(fields: [merchantId], references: [id])
  createdAt    DateTime  @default(now())

  @@map("users")
}

model MerchantSyncConfig {
  id          String   @id @default(uuid())
  merchantId  String   @unique
  merchant    Merchant @relation(fields: [merchantId], references: [id], onDelete: Cascade)

  productsEndpoint   String?
  inventoryEndpoint  String? 
  ordersEndpoint     String? 
  checkoutWebhookUrl String? 

  fieldMap    Json

  productsArrayPath String @default("$")

  authType    String   @default("none")  
  authConfigEncrypted String? 

  pollIntervalMs      Int      @default(300000)
  paginationConfig    Json?    
  active              Boolean  @default(true)
  circuitState        String   @default("CLOSED") 
  consecutiveFailures Int      @default(0)
  lastFailureAt       DateTime?
  lastSuccessAt       DateTime?

  staleAfterSeconds   Int    @default(600)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("merchant_sync_configs")
}

model SyncRun {
  id            String   @id @default(uuid())
  configId      String
  startedAt     DateTime @default(now())
  finishedAt    DateTime?
  status        String   
  itemsFetched  Int      @default(0)
  itemsUpserted Int      @default(0)
  itemsFailed   Int      @default(0)
  errorSummary  Json?

  @@map("sync_runs")
}

model SyncLog {
  id          String     @id @default(uuid())
  merchantId  String
  merchant    Merchant   @relation(fields: [merchantId], references: [id], onDelete: Cascade)

  status      SyncStatus
  entityType  String     
  recordsProcessed Int   @default(0)
  recordsFailed    Int   @default(0)
  errorMessage     String?
  durationMs       Int?

  startedAt   DateTime   @default(now())
  completedAt DateTime?

  @@index([merchantId, startedAt])
  @@index([merchantId, entityType, startedAt])
  @@map("sync_logs")
}

model Product {
  id          String        @id @default(uuid())
  merchantId  String
  merchant    Merchant      @relation(fields: [merchantId], references: [id], onDelete: Cascade)

  externalId  String        
  externalUrl String?       

  title       String
  description String?
  category    String?
  tags        String[]      @default([])
  brand       String?

  price       Decimal       @db.Decimal(12, 2)
  compareAtPrice Decimal?   @db.Decimal(12, 2) 
  currency    String        @default("INR")

  images      Json          @default("[]") 

  status      ProductStatus          @default(ACTIVE)
  availability AvailabilityStatus    @default(IN_STOCK)

  agentPurchasable Boolean  @default(true)

  contentHash String?       
  lastSyncedAt DateTime?
  isStale     Boolean       @default(false)
  staleReason String?

  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  variants    ProductVariant[]
  cartItems   CartItem[]

  @@unique([merchantId, externalId])
  @@index([merchantId, status])
  @@index([merchantId, category])
  @@index([merchantId, availability])
  @@map("products")
}

model ProductVariant {
  id          String   @id @default(uuid())
  productId   String
  product     Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  externalId  String   
  title       String   

  // Pricing override (null = inherit from parent product)
  price       Decimal? @db.Decimal(12, 2)
  compareAtPrice Decimal? @db.Decimal(12, 2)

  attributes  Json     @default("{}")

  sku         String?
  barcode     String?
  weight      Decimal? @db.Decimal(8, 3) 
  weightUnit  String?  @default("kg")

  agentPurchasable Boolean @default(true)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  inventory   Inventory?
  cartItems   CartItem[]

  @@unique([productId, externalId])
  @@index([productId])
  @@map("product_variants")
}

model Inventory {
  id          String         @id @default(uuid())
  variantId   String         @unique
  variant     ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  stock       Int            @default(0)
  reservedStock Int          @default(0) 
  availability AvailabilityStatus @default(IN_STOCK)

  lowStockThreshold Int?     
  trackQuantity    Boolean   @default(true)

  lastSyncedAt DateTime?
  updatedAt    DateTime      @updatedAt

  @@index([variantId])
  @@map("inventory")
}

model Cart {
  id          String     @id @default(uuid())
  merchantId  String
  merchant    Merchant   @relation(fields: [merchantId], references: [id], onDelete: Cascade)

  agentSessionId String?
  externalCartId String?  

  status      CartStatus @default(ACTIVE)

  subtotal    Decimal    @db.Decimal(12, 2) @default(0)
  taxAmount   Decimal    @db.Decimal(12, 2) @default(0)
  discountAmount Decimal @db.Decimal(12, 2) @default(0)
  total       Decimal    @db.Decimal(12, 2) @default(0)
  currency    String     @default("INR")

  coupons     Json       @default("[]")

  version     Int        @default(1)

  expiresAt   DateTime?

  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  items       CartItem[]
  order       Order?
  mandates    CartMandate[]

  @@index([merchantId, agentSessionId])
  @@index([merchantId, status])
  @@map("carts")
}

model CartItem {
  id          String         @id @default(uuid())
  cartId      String
  cart        Cart           @relation(fields: [cartId], references: [id], onDelete: Cascade)

  productId   String
  product     Product        @relation(fields: [productId], references: [id])

  variantId   String?
  variant     ProductVariant? @relation(fields: [variantId], references: [id])

  quantity    Int
  unitPrice   Decimal        @db.Decimal(12, 2) 
  lineTotal   Decimal        @db.Decimal(12, 2) 

  productTitle   String
  variantTitle   String?

  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@index([cartId])
  @@index([productId])
  @@map("cart_items")
}

model Order {
  id          String            @id @default(uuid())
  merchantId  String
  merchant    Merchant          @relation(fields: [merchantId], references: [id])

  cartId      String            @unique
  cart        Cart              @relation(fields: [cartId], references: [id])

  externalOrderId String?

  status          OrderStatus       @default(PENDING)
  fulfillmentStatus FulfillmentStatus @default(UNFULFILLED)

  subtotal    Decimal           @db.Decimal(12, 2)
  taxAmount   Decimal           @db.Decimal(12, 2)
  discountAmount Decimal        @db.Decimal(12, 2)
  total       Decimal           @db.Decimal(12, 2)
  currency    String

  customerEmail String?
  customerName  String?
  shippingAddress Json?   
  billingAddress  Json?

  trackingNumber String?
  trackingUrl    String?
  estimatedDelivery DateTime?

  agentSessionId String?
  agentCallbackUrl String? 

  notes       String?
  internalNotes String?

  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  paymentIntents  PaymentIntent[]
  transactionEvents TransactionEvent[]

  @@index([merchantId, status])
  @@index([merchantId, externalOrderId])
  @@index([agentSessionId])
  @@map("orders")
}

model PaymentIntent {
  id          String            @id @default(uuid())
  merchantId  String
  merchant    Merchant          @relation(fields: [merchantId], references: [id])

  orderId     String
  order       Order             @relation(fields: [orderId], references: [id])

  idempotencyKey String         @unique

  amount      Decimal           @db.Decimal(12, 2)
  currency    String            @default("INR")

  status      TransactionStatus @default(INTENT_CREATED)

  pspProvider String            @default("razorpay")
  pspOrderId  String?           
  pspPaymentId String?          
  pspSignature String?          

  gateDecision GateDecision?
  gateRule    String?
  gateMessage String?

  checkoutToken String?
  checkoutTokenExpiresAt DateTime?

  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  transactionEvents TransactionEvent[]
  outboxEntries     Outbox[]

  @@index([merchantId, status])
  @@index([orderId])
  @@index([pspOrderId])
  @@map("payment_intents")
}

model TransactionEvent {
  id              String    @id @default(uuid())

  paymentIntentId String
  paymentIntent   PaymentIntent @relation(fields: [paymentIntentId], references: [id])

  orderId         String
  order           Order     @relation(fields: [orderId], references: [id])

  eventType       EventType
  actor           String
  payload         Json      @default("{}")
  correlationId   String
  pspEventId      String?   @unique
  prevHash        String?
  cartStateHash   String?
  createdAt       DateTime  @default(now()) @db.Timestamptz

  @@index([paymentIntentId, createdAt])
  @@index([orderId, createdAt])
  @@index([correlationId])
  @@index([eventType])
  @@map("transaction_events")
}

model Outbox {
  id              String       @id @default(uuid())
  paymentIntentId String
  paymentIntent   PaymentIntent @relation(fields: [paymentIntentId], references: [id])

  actionType      String       
  payload         Json

  status          OutboxStatus @default(PENDING)

  attempts        Int          @default(0)
  maxAttempts     Int          @default(5)
  lastAttemptAt   DateTime?
  nextRetryAt     DateTime?
  errorMessage    String?

  correlationId   String

  createdAt       DateTime     @default(now())
  processedAt     DateTime?

  @@index([status, nextRetryAt])
  @@index([paymentIntentId])
  @@map("outbox")
}

model CartMandate {
  id          String   @id @default(uuid())
  cartId      String
  cart        Cart     @relation(fields: [cartId], references: [id], onDelete: Cascade)
  stateHash   String
  issuedAt    DateTime @default(now())
  expiresAt   DateTime
  consumed    Boolean  @default(false)

  @@index([cartId, stateHash])
  @@map("cart_mandates")
}

model WebhookDelivery {
  id            String   @id @default(uuid())
  outboxId      String
  merchantId    String
  url           String
  attempt       Int      @default(1)
  statusCode    Int?
  responseBody  String?
  succeeded     Boolean  @default(false)
  attemptedAt   DateTime @default(now())

  @@index([outboxId])
  @@map("webhook_deliveries")
}

model AgentClient {
  id               String   @id @default(uuid())
  name             String
  clientId         String   @unique
  clientSecretHash String
  scopes           String[] 
  revoked          Boolean  @default(false)
  createdAt        DateTime @default(now())

  @@map("agent_clients")
}
