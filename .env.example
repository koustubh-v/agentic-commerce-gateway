# --- Server ---
NODE_ENV=development
PORT=3000
HOST=0.0.0.0
LOG_LEVEL=info

# --- PostgreSQL (Prisma) ---
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=postgresql://acg:acg_secret@localhost:5432/acg_db

# --- Redis ---
REDIS_URL=redis://localhost:6379
# Optional: Redis password (leave empty if no auth)
REDIS_PASSWORD=

# --- JWT ---
# Generate a strong secret: openssl rand -base64 64
JWT_SECRET=change_me_to_a_strong_random_secret_at_least_64_chars_long
JWT_EXPIRY=7d

# --- Razorpay (Test Mode) ---
# Get keys from https://dashboard.razorpay.com/app/keys
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx
# Webhook secret configured in Razorpay dashboard
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret

# --- Money-Action Gate Defaults ---
# These are platform-level defaults; merchants can override per-merchant in DB
GATE_DEFAULT_PER_TRANSACTION_CAP_INR=10000
GATE_DEFAULT_PER_SESSION_CAP_INR=50000
GATE_DEFAULT_VELOCITY_TRANSACTIONS_PER_HOUR=10

# --- Sync (Mode A polling) ---
# Default poll interval in minutes for Mode A merchants
SYNC_DEFAULT_POLL_INTERVAL_MINUTES=5
# Data older than this (seconds) gets flagged as stale in agent responses
SYNC_STALE_AFTER_SECONDS=600

# --- BullMQ ---
# Concurrency for the sync worker pool
BULLMQ_SYNC_CONCURRENCY=5
BULLMQ_OUTBOX_CONCURRENCY=10

# --- Cache TTL ---
CACHE_PRODUCT_TTL_SECONDS=300
CACHE_INVENTORY_TTL_SECONDS=60
CACHE_CART_TTL_SECONDS=1800
CACHE_ORDER_TTL_SECONDS=120

# --- Webhook HMAC ---
# Secret for signing outbound webhooks to merchants
WEBHOOK_SIGNING_SECRET=change_me_to_another_strong_secret

# --- Reconciler ---
# How often (in ms) to poll for UNCERTAIN transactions
RECONCILER_POLL_INTERVAL_MS=90000
# Transactions older than this (seconds) in PSP_PENDING trigger reconciliation
RECONCILER_THRESHOLD_SECONDS=120
